Dialogue: 0,0:02:39.30,0:02:42.82,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)\fs45}Caesar's Laboratory - Main Entrance
Dialogue: 0,0:02:39.78,0:02:40.85,Main,Soldier,0,0,0,,Ouvrez !
Dialogue: 0,0:02:42.98,0:02:45.16,Main,Soldier,0,0,0,,Hé, ouvrez les portes !
Dialogue: 0,0:02:45.16,0:02:47.49,Main,Soldier,0,0,0,,Rendez-nous Smokey et Tashigi-chan !
Dialogue: 0,0:02:48.08,0:02:50.59,Main,Soldier,0,0,0,,Qu'est-ce que c'est ? Un dirigeable ?
Dialogue: 0,0:02:58.61,0:03:00.50,Main,Caesar,0,0,0,,Bon les enfants, il est temps de descendre.
Dialogue: 0,0:03:01.25,0:03:03.32,Main,Caesar,0,0,0,,C'est votre maison.
Dialogue: 0,0:03:04.38,0:03:07.08,Main,Caesar,0,0,0,,Ne vous éloignez pas encore.
Dialogue: 0,0:03:07.42,0:03:09.70,Main,Sind,0,0,0,,Merci, Maître.
Dialogue: 0,0:03:10.83,0:03:14.24,Main,Child,0,0,0,,Mouton, des bonbons s'il te plaît...
Dialogue: 0,0:03:15.62,0:03:18.69,Main,Sind,0,0,0,,Donne-nous les bonbons maintenant, Maître !
Dialogue: 0,0:03:18.69,0:03:23.05,Main,Doran,0,0,0,,J'ai mal à la tête ! Maître, donne-nous les bonbons...
Dialogue: 0,0:03:23.05,0:03:25.56,Main,Caesar,0,0,0,,Vous aurez les bonbons bientôt, bien sûr.
Dialogue: 0,0:03:27.23,0:03:32.34,Main,Caesar,0,0,0,,Retournez directement à la Salle des Biscuits.
Dialogue: 0,0:03:32.34,0:03:35.93,Main,Caesar,0,0,0,,Beaucoup de bonbons vous y attendent.
Dialogue: 0,0:03:35.93,0:03:40.13,Main,Caesar,0,0,0,,Je dois aller au laboratoire.
Dialogue: 0,0:03:40.54,0:03:43.55,Main,Caesar,0,0,0,,Alors détendez-vous et savourez.
Dialogue: 0,0:03:43.55,0:03:46.63,Main,Caesar,0,0,0,,Les délicieux, délicieux bonbons.
Dialogue: 0,0:03:49.26,0:03:53.10,Main,Doran,0,0,0,,Allons dans la salle ! Montre-nous le chemin, Mouton.
Dialogue: 0,0:03:53.10,0:03:55.15,Main,Soldier,0,0,0,,Par ici, les enfants.
Dialogue: 0,0:03:56.65,0:03:58.16,Main,Konbu,0,0,0,,La Salle des Biscuits.
Dialogue: 0,0:03:58.16,0:03:59.67,Main,Ally,0,0,0,,Bonbons... maintenant...
Dialogue: 0,0:04:01.30,0:04:03.24,Main,Caesar,0,0,0,,Toi ! Écoute bien.
Dialogue: 0,0:04:03.24,0:04:09.40,Main,Caesar,0,0,0,,Une fois dans la salle, enferme-les bien\Npour qu'ils ne puissent plus s'échapper, compris ?
Dialogue: 0,0:04:09.40,0:04:10.44,Main,Soldier,0,0,0,,Compris.
Dialogue: 0,0:04:13.63,0:04:15.57,Main,Mocha,0,0,0,,Cet endroit fait peur !
Dialogue: 0,0:04:15.57,0:04:18.20,Main,Soldier,0,0,0,,Quoi, sale môme ?
Dialogue: 0,0:04:18.20,0:04:20.36,Main,Soldier,0,0,0,,Euh, je veux dire, jeune demoiselle ?
Dialogue: 0,0:04:20.51,0:04:27.01,Main,Soldier,0,0,0,,Pourquoi tu ne vas pas avec les autres enfants\Nmanger tes délicieux bonbons dans ta chambre ?
Dialogue: 0,0:04:30.41,0:04:31.78,Main,Soldier,0,0,0,,Quoi ? Qu'est-ce qui ne va pas ?
Dialogue: 0,0:04:35.75,0:04:39.76,Flashbacks,Usopp,0,0,0,,Tu ne veux pas retourner au labo, hein ?!
Dialogue: 0,0:04:39.76,0:04:42.05,Flashbacks,Child,0,0,0,,Dégage de mon chemin !
Dialogue: 0,0:04:43.47,0:04:44.22,Flashbacks,Nami,0,0,0,,Usopp !
Dialogue: 0,0:04:44.54,0:04:46.91,Flashbacks,Child,0,0,0,,Maître... donne-moi des bonbons...
Dialogue: 0,0:04:49.52,0:04:53.93,Flashbacks,Caesar,0,0,0,,C'est ça. Venez, les enfants.
Dialogue: 0,0:04:53.93,0:04:58.30,Flashbacks,Nami,0,0,0,,Arrêtez, s'il vous plaît ! Vous ne pouvez pas aller vers lui !
Dialogue: 0,0:04:58.30,0:05:00.74,Flashbacks,Nami,0,0,0,,Vous voulez rentrer chez vous, non ?
Dialogue: 0,0:05:01.20,0:05:03.23,Main,Soldiers,0,0,0,,Hop-là !
Dialogue: 0,0:05:06.10,0:05:08.54,Main,Mocha,0,0,0,,Non ! Je veux vraiment partir !
Dialogue: 0,0:05:09.60,0:05:11.12,Main,Soldier,0,0,0,,De quoi tu parles, gamin ?
Dialogue: 0,0:05:11.12,0:05:14.04,Main,Soldier,0,0,0,,Il fait froid dehors,\Net t'as pas vu à quel étage t'es ?
Dialogue: 0,0:05:14.04,0:05:15.49,Main,Soldier,0,0,0,,Maintenant, retourne dans ta chambre.
Dialogue: 0,0:05:15.49,0:05:18.31,Main,Mocha,0,0,0,,Non ! Sauve-moi, madame !
Dialogue: 0,0:05:19.19,0:05:20.43,Main,Uzu,0,0,0,,Mocha ?
Dialogue: 0,0:05:20.43,0:05:22.89,Main,Child,0,0,0,,Allons chercher les bonbons maintenant !
Dialogue: 0,0:05:23.99,0:05:24.94,Main,Mocha,0,0,0,,Oh, c'est vrai !
Dialogue: 0,0:05:24.94,0:05:27.45,Main,Mocha,0,0,0,,Je suis désolé de ne pas t'avoir écoutée !
Dialogue: 0,0:05:27.45,0:05:30.79,Main,Mocha,0,0,0,,Monsieur ! Madame ! Sauvez-moi !
Dialogue: 0,0:05:30.79,0:05:33.00,Main,Soldier,0,0,0,,Hé, toi ! Éloigne-toi de la porte !
Dialogue: 0,0:05:33.00,0:05:35.57,Main,Soldier,0,0,0,,Pff, quel gamin embêtant !
Dialogue: 0,0:05:35.57,0:05:38.30,Main,Mocha,0,0,0,,Sauve-moi, madame !
Dialogue: 0,0:05:40.33,0:05:43.51,Main,Mocha,0,0,0,,{\i1}Madame !
Dialogue: 0,0:05:48.98,0:05:51.27,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)\fs45}The Ruins of Laboratories One and Two
Dialogue: 0,0:05:52.05,0:05:55.16,Main,Nami,0,0,0,,Le corps de Sanji-kun a pris cher...
Dialogue: 0,0:05:55.80,0:05:57.47,Main,Nami,0,0,0,,mais il est tellement solide.
Dialogue: 0,0:06:00.58,0:06:01.33,Main,Nami,0,0,0,,Usopp !
Dialogue: 0,0:06:05.71,0:06:08.22,Main,Nami,0,0,0,,Tiens bon, Usopp !
Dialogue: 0,0:06:10.43,0:06:13.94,Main,Usopp,0,0,0,,Tu es venu me sauver, Sanji ?
Dialogue: 0,0:06:13.94,0:06:15.54,Main,Nami,0,0,0,,Je suis Nami !
Dialogue: 0,0:06:16.60,0:06:19.14,Main,Nami,0,0,0,,Pourquoi t'as l'air si déçu ?
Dialogue: 0,0:06:22.04,0:06:24.09,Main,Caesar,0,0,0,,Désolé de t'avoir fait attendre, Vergo.
Dialogue: 0,0:06:24.59,0:06:28.26,Main,Vergo,0,0,0,,T'inquiète. J'ai pris un café et des biscuits.
Dialogue: 0,0:06:29.64,0:06:32.46,Main,Vergo,0,0,0,,C'est bizarre, où sont les biscuits ?
Dialogue: 0,0:06:32.46,0:06:34.56,Main,Monet,0,0,0,,Je ne t'en ai pas donné.
Dialogue: 0,0:06:34.56,0:06:38.39,Main,Vergo,0,0,0,,Ah oui, je n'ai pas eu de biscuits.
Dialogue: 0,0:06:38.39,0:06:41.52,Main,Vergo,0,0,0,,Quand vas-tu commencer l'expérience, Caesar ?
Dialogue: 0,0:06:41.52,0:06:44.77,Main,Caesar,0,0,0,,Bientôt... Monet, lance la transmission.
Dialogue: 0,0:06:44.77,0:06:45.44,Main,Monet,0,0,0,,Oui, chef.
Dialogue: 0,0:06:47.44,0:06:53.70,Main,Caesar,0,0,0,,J'aimerais vraiment que tu tiennes\Ntes subordonnés en laisse, Vergo.
Dialogue: 0,0:06:53.98,0:06:58.40,Main,Caesar,0,0,0,,J'ai eu une sueur froide quand Smoker est venu ici.
Dialogue: 0,0:06:58.40,0:07:02.32,Main,Vergo,0,0,0,,Tu as raison. C'est un chien errant qu'on ne peut pas dresser.
Dialogue: 0,0:07:03.48,0:07:07.59,Main,Caesar,0,0,0,,Mais tout ça est derrière nous, non ?
Dialogue: 0,0:07:08.52,0:07:12.32,Main,Caesar,0,0,0,,Bien fait pour toi, Law !
Dialogue: 0,0:07:14.83,0:07:19.18,Main,Caesar,0,0,0,,Tu étais impuissant face à Vergo, hein ?
Dialogue: 0,0:07:19.90,0:07:23.38,Main,Caesar,0,0,0,,L'accord que j'avais avec toi était utile.
Dialogue: 0,0:07:25.13,0:07:31.06,Flashbacks,Caesar,0,0,0,,En échange de pouvoir rester ici, tu donneras des jambes à mes subordonnés.
Dialogue: 0,0:07:31.66,0:07:33.59,Flashbacks,Caesar,0,0,0,,Je t'en serais très reconnaissant.
Dialogue: 0,0:07:33.88,0:07:34.82,Flashbacks,Caesar,0,0,0,,Cependant...
Dialogue: 0,0:07:35.54,0:07:41.09,Flashbacks,Caesar,0,0,0,,Tu es plus fort que moi,\Nmais c'est moi le chef sur cette île.
Dialogue: 0,0:07:41.09,0:07:45.16,Flashbacks,Caesar,0,0,0,,Si tu veux rester ici,\Non ferait mieux d'affaiblir un peu ta position.
Dialogue: 0,0:07:45.16,0:07:47.82,Flashbacks,Law,0,0,0,,Je ne te ferai aucun mal.
Dialogue: 0,0:07:47.82,0:07:49.29,Flashbacks,Law,0,0,0,,Que dois-je faire pour que tu te sentes en sécurité ?
Dialogue: 0,0:07:49.52,0:07:52.76,Flashbacks,Caesar,0,0,0,,J'ai une proposition, Trafalgar Law.
Dialogue: 0,0:07:53.48,0:07:59.68,Flashbacks,Caesar,0,0,0,,Je veux que tu prennes soin\Ndu cœur de ma chère secrétaire Monet.
Dialogue: 0,0:08:01.05,0:08:02.97,Flashbacks,Caesar,0,0,0,,Ça te va, Monet ?
Dialogue: 0,0:08:03.26,0:08:05.92,Flashbacks,Monet,0,0,0,,Oui, je ne vois aucun problème.
Dialogue: 0,0:08:06.43,0:08:11.63,Flashbacks,Caesar,0,0,0,,Et en échange... je veux ton cœur !
Dialogue: 0,0:08:11.63,0:08:13.96,Flashbacks,Caesar,0,0,0,,Voilà le marché.
Dialogue: 0,0:08:15.00,0:08:20.43,Flashbacks,Caesar,0,0,0,,Tant qu'on se tient par la gorge, tu ne seras pas tenté de faire des bêtises.
Dialogue: 0,0:08:20.43,0:08:21.88,Flashbacks,Caesar,0,0,0,,Et je pourrai être tranquille aussi.
Dialogue: 0,0:08:26.30,0:08:29.56,Main,Caesar,0,0,0,,J'ai toujours cru qu'on ne pouvait faire confiance à personne.
Dialogue: 0,0:08:29.56,0:08:31.98,Main,Caesar,0,0,0,,On récolte ce qu'on sème, comme on dit.
Dialogue: 0,0:08:31.98,0:08:33.87,Main,Caesar,0,0,0,,Tu as dû déjà découvrir...
Dialogue: 0,0:08:34.18,0:08:37.99,Main,Caesar,0,0,0,,que maintenant, Vergo a ton cœur.
Dialogue: 0,0:08:42.79,0:08:43.47,Main,Luffy,0,0,0,,Hé !
Dialogue: 0,0:08:44.93,0:08:49.57,Main,Caesar,0,0,0,,Je suppose que même toi, tu n'aurais pas pu prévoir...
Dialogue: 0,0:08:49.57,0:08:54.99,Main,Caesar,0,0,0,,que Monet est assez maligne pour changer d'apparence et te suivre.
Dialogue: 0,0:08:58.15,0:09:00.79,Main,Luffy,0,0,0,,Hé, ça va, Traf ?
Dialogue: 0,0:09:00.79,0:09:03.29,Main,Caesar,0,0,0,,Elle a tout entendu de ce que vous planifiez.
Dialogue: 0,0:09:03.62,0:09:06.31,Main,Caesar,0,0,0,,Je suis déçu, Law.
Dialogue: 0,0:09:06.31,0:09:10.39,Main,Caesar,0,0,0,,Je pensais qu'on était enfin devenus de très bons amis.
Dialogue: 0,0:09:13.27,0:09:19.55,Main,Law,0,0,0,,Alors tu as été sauvé par ton exceptionnelle secrétaire ? J'aurais dû faire plus attention à elle.
Dialogue: 0,0:09:20.14,0:09:24.22,Main,Law,0,0,0,,Je me suis laissé aller à la négligence\Nparce que tu es un idiot maladroit.
Dialogue: 0,0:09:28.04,0:09:30.63,Main,Caesar,0,0,0,,Surveille ton langage, gamin.
Dialogue: 0,0:09:31.04,0:09:35.02,Main,Luffy,0,0,0,,C'est incroyable. Tu es encore en vie\Nmême si ce type a ton cœur ?
Dialogue: 0,0:09:35.76,0:09:39.97,Main,Smoker,0,0,0,,À la merci de ton propre pouvoir, Law ?
Dialogue: 0,0:09:39.97,0:09:42.26,Main,Smoker,0,0,0,,J'aimerais savoir ce que tu as fait de mon cœur.
Dialogue: 0,0:09:44.52,0:09:49.97,Main,Caesar,0,0,0,,Par ici ! Smo{\fscx250}-{\r}
Dialogue: 0,0:09:49.97,0:09:54.04,Main,Monet,0,0,0,,Maître, on est prêts à lancer la diffusion.
Dialogue: 0,0:09:54.04,0:09:55.24,Main,Caesar,0,0,0,,Oh, vraiment ?
Dialogue: 0,0:09:56.45,0:09:57.70,Main,Caesar,0,0,0,,Tu échappes à la mort, pour l'instant.
Dialogue: 0,0:10:04.47,0:10:06.42,Main,Caesar,0,0,0,,D'accord, commence.
Dialogue: 0,0:10:07.95,0:10:09.69,Main,Soldier,0,0,0,,Quelque chose est projeté !
Dialogue: 0,0:10:09.69,0:10:12.80,Main,Soldier,0,0,0,,Qu'est-ce que c'est ? Où est-ce ? Est-ce que...
Dialogue: 0,0:10:12.80,0:10:15.09,Main,Soldier,0,0,0,,un bonbon ? Un énorme bonbon !
Dialogue: 0,0:10:15.57,0:10:25.21,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)\fs45}Various New World Locations - Underworld Brokers
Dialogue: 0,0:10:15.42,0:10:20.00,Main,Caesar,0,0,0,,Les Petits Smileys ont été dispersés depuis les Terres Brûlantes...
Dialogue: 0,0:10:20.00,0:10:25.21,Main,Caesar,0,0,0,,et vont bientôt se rassembler au milieu des Terres Gelées.
Dialogue: 0,0:10:25.21,0:10:33.22,Main,Caesar,0,0,0,,Une fois qu'ils se seront tous réunis\Net seront devenus le Smiley complet,
Dialogue: 0,0:10:33.91,0:10:35.90,Main,Caesar,0,0,0,,l'expérience commencera.
Dialogue: 0,0:10:47.21,0:10:57.94,Main,Caesar,0,0,0,,Il y a quatre ans, une explosion a complètement dévasté\Ncette île. C'était une bombe à gaz toxique, appelée H{\fs28}2{\fs55}S.
Dialogue: 0,0:10:57.94,0:10:59.41,Main,Caesar,0,0,0,,{\i1}C'est{\i0} ce qu'est Smiley.
Dialogue: 0,0:11:01.93,0:11:03.86,Main,Caesar,0,0,0,,Mais la dernière fois, il y a eu un problème.
Dialogue: 0,0:11:10.48,0:11:19.21,Main,Caesar,0,0,0,,Les gens qui ont inhalé le poison étaient affaiblis\Nmais ils ont pu trouver des endroits sûrs pour se mettre à l'abri.
Dialogue: 0,0:11:19.87,0:11:27.05,Main,Caesar,0,0,0,,Alors je prévois de donner à l'arme\Nd'il y a quatre ans, Smiley, une énorme friandise.
Dialogue: 0,0:11:27.92,0:11:35.31,Main,Caesar,0,0,0,,Une qui complétera le gaz toxique\Npour devenir une arme de destruction massive parfaite.
Dialogue: 0,0:11:36.24,0:11:38.56,Main,Caesar,0,0,0,,Aujourd'hui marque la naissance d'une nouvelle arme.
Dialogue: 0,0:11:38.56,0:11:39.78,Main,Caesar,0,0,0,,Son nom sera...
Dialogue: 0,0:11:40.82,0:11:42.46,Main,Caesar,0,0,0,,Shinokuni !
Dialogue: 0,0:11:40.82,0:11:42.46,Note,Caesar,0,0,0,,{\fad(100,0)}Terre de la Mort
Dialogue: 0,0:11:42.88,0:11:46.90,Captions,Caption,0,0,0,,{\pos(640,547)\fad(560,0)\fs45}Frozen Lands - Central Area
Dialogue: 0,0:11:50.92,0:11:52.89,Main,Zoro,0,0,0,,Ça arrive !
Dialogue: 0,0:11:53.86,0:11:56.11,Main,Zoro,0,0,0,,On ne peut pas s'en éloigner ?
Dialogue: 0,0:12:03.75,0:12:07.52,Main,Sanji,0,0,0,,Il s'est complètement fusionné de ce côté !
Dialogue: 0,0:12:07.52,0:12:11.05,Main,Kin'emon,0,0,0,,Qu'est-ce que c'est que ce truc ?
Dialogue: 0,0:12:11.05,0:12:13.94,Main,Zoro,0,0,0,,Pas le temps de s'en inquiéter. Concentre-toi pour courir.
Dialogue: 0,0:12:15.58,0:12:18.97,Main,Brook,0,0,0,,Excusez-moi, tout le monde.\NIl semble y avoir une énorme boule devant nous !
Dialogue: 0,0:12:19.55,0:12:21.24,Main,Zoro,0,0,0,,Qu'est-ce que c'est ?
Dialogue: 0,0:12:21.24,0:12:24.30,Main,Sanji,0,0,0,,C'est en forme de bonbon ?
Dialogue: 0,0:12:24.30,0:12:26.35,Main,Zoro,0,0,0,,Il y a des gens à côté.
Dialogue: 0,0:12:28.22,0:12:31.72,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)\fs45}Vegapunk's Dragon (Miniature)
Dialogue: 0,0:12:32.25,0:12:36.06,Main,Soldier,0,0,0,,Maître, je confirme une créature gélatineuse Géant.
Dialogue: 0,0:12:36.06,0:12:38.29,Main,Soldier,0,0,0,,Nous pensons que c'est Smiley.
Dialogue: 0,0:12:39.39,0:12:43.74,Main,Soldier,0,0,0,,Alors, on va procéder comme prévu\Net projeter la diffusion du Maître sur la brume.
Dialogue: 0,0:12:43.74,0:12:45.05,Main,Caesar,0,0,0,,Bien.
Dialogue: 0,0:12:45.05,0:12:50.61,Main,Caesar,0,0,0,,Une fois le travail terminé,\Ntu dois t'enfuir ou tu seras en grave danger.
Dialogue: 0,0:12:50.61,0:12:53.28,Main,Caesar,0,0,0,,Monte sur le traîneau Dragon et dépêche-{\fscx250}-{\r}
Dialogue: 0,0:12:53.28,0:12:54.16,Main,Caesar,0,0,0,,Qu'est-ce qui s'est passé ?
Dialogue: 0,0:12:54.86,0:12:56.15,Main,Soldier,0,0,0,,Nous...
Dialogue: 0,0:12:56.15,0:12:59.55,Main,Soldier,0,0,0,,On a un problème avec le traîneau. Il semble fondre !
Dialogue: 0,0:12:59.55,0:13:02.49,Main,Soldier,0,0,0,,On ne peut pas l'utiliser comme ça !
Dialogue: 0,0:13:07.06,0:13:08.75,Main,Soldier,0,0,0,,Pourquoi ça arrive maintenant ?!
Dialogue: 0,0:13:08.75,0:13:12.59,Main,Soldier,0,0,0,,C'est une réaction chimique ? C'est complètement inutilisable maintenant.
Dialogue: 0,0:13:13.49,0:13:15.32,Main,Soldier,0,0,0,,Le Dragon s'enfuit !
Dialogue: 0,0:13:15.32,0:13:17.90,Main,Soldier,0,0,0,,Une chose après l’autre !
Dialogue: 0,0:13:17.90,0:13:20.83,Main,Caesar,0,0,0,,Quoi ?!
Dialogue: 0,0:13:20.83,0:13:24.16,Main,Caesar,0,0,0,,Quelle terrible chose à arriver !
Dialogue: 0,0:13:25.77,0:13:27.09,Main,Monet,0,0,0,,Pas très convaincant.
Dialogue: 0,0:13:27.09,0:13:29.97,Main,Caesar,0,0,0,,Les gars, fuyez !
Dialogue: 0,0:13:29.97,0:13:32.22,Main,Caesar,0,0,0,,Vos combinaisons de protection sont inutiles maintenant !
Dialogue: 0,0:13:32.66,0:13:36.77,Main,Caesar,0,0,0,,Enlevez-les et courez jusqu’au laboratoire !
Dialogue: 0,0:13:36.77,0:13:38.87,Main,Soldier,0,0,0,,C-Compris.
Dialogue: 0,0:13:38.87,0:13:40.42,Main,Soldier,0,0,0,,Enlever nos combinaisons ?
Dialogue: 0,0:13:40.42,0:13:43.76,Main,Soldier,0,0,0,,Les ordres du Maître sont absolus ! Il doit avoir un plan !
Dialogue: 0,0:13:43.76,0:13:45.73,Main,Soldier,0,0,0,,Faites ce qu’il vous dit !
Dialogue: 0,0:13:48.64,0:13:50.58,Main,Soldier,0,0,0,,D-Dépêchez-vous !
Dialogue: 0,0:13:54.57,0:13:57.53,Main,Soldier,0,0,0,,Allume-toi, bon sang !
Dialogue: 0,0:13:59.56,0:14:04.57,Main,Brook,0,0,0,,Quoi ? Maintenant l’image de quelqu’un est projetée dans les airs !
Dialogue: 0,0:14:04.57,0:14:08.16,Main,Sanji,0,0,0,,Ignore ça. Ignore ça. De toute façon, fuyez !
Dialogue: 0,0:14:10.56,0:14:15.12,Main,Caesar,0,0,0,,Smiley ! Tu m’as manqué !
Dialogue: 0,0:14:15.80,0:14:17.54,Main,Caesar,0,0,0,,Ça fait trois longues années !
Dialogue: 0,0:14:20.72,0:14:25.03,Main,Caesar,0,0,0,,Oh, oui, Smiley !
Dialogue: 0,0:14:25.03,0:14:29.83,Main,Caesar,0,0,0,,Ça rappelle tellement de souvenirs ! \NJe t’ai préparé une friandise très, très savoureuse !
Dialogue: 0,0:14:30.57,0:14:33.01,Main,Caesar,0,0,0,,Reste ! Reste là, Smiley !
Dialogue: 0,0:14:33.67,0:14:35.74,Main,Caesar,0,0,0,,Encore un peu !
Dialogue: 0,0:14:37.69,0:14:40.32,Main,Caesar,0,0,0,,Les ordres de ton Maître sont absolus !
Dialogue: 0,0:14:40.32,0:14:42.04,Main,Caesar,0,0,0,,C’est comme ça que je t’ai dressé.
Dialogue: 0,0:14:42.04,0:14:44.31,Main,Caesar,0,0,0,,Reste ! Je t’ai dit de rester !
Dialogue: 0,0:14:45.07,0:14:49.98,Main,Caesar,0,0,0,,J’ai tellement de choses à te raconter !\NTu te souviens ?
Dialogue: 0,0:14:49.98,0:14:53.25,Main,Caesar,0,0,0,,Tout a commencé, oui, il y a quatre ans…
Dialogue: 0,0:14:58.85,0:15:00.22,Main,Caesar,0,0,0,,D-D’accord !
Dialogue: 0,0:15:00.99,0:15:04.00,Main,Caesar,0,0,0,,D’accord alors ! Tu peux manger maintenant ! Bon chien !
Dialogue: 0,0:15:04.66,0:15:07.28,Main,Monet,0,0,0,,Il ne t’écoute pas.
Dialogue: 0,0:15:12.23,0:15:13.60,Main,Caesar,0,0,0,,Il l’a mangée.
Dialogue: 0,0:15:13.60,0:15:16.37,Main,Caesar,0,0,0,,Il l’a mangée ! Il a mangé la friandise !
Dialogue: 0,0:15:17.83,0:15:21.95,Main,Caesar,0,0,0,,Tu l’as mangée, n’est-ce pas, Smiley ?
Dialogue: 0,0:15:30.26,0:15:32.47,Main,Caesar,0,0,0,,Renais.
Dialogue: 0,0:15:36.13,0:15:38.97,Main,Franky,0,0,0,,Alors ça deviendra quelque chose d’encore plus terrifiant ?
Dialogue: 0,0:15:39.44,0:15:42.46,Main,Robin,0,0,0,,Une arme de destruction massive parfaite.
Dialogue: 0,0:15:42.46,0:15:44.72,Main,Luffy,0,0,0,,C’est une grosse grenouille !
Dialogue: 0,0:15:54.26,0:15:56.53,Main,Centaur,0,0,0,,Ça commence. Quelque chose commence à se passer !
Dialogue: 0,0:15:56.53,0:15:58.24,Main,Centaur2,0,0,0,,Mais que va-t-il se passer exactement ?
Dialogue: 0,0:15:58.24,0:16:00.74,Main,Centaur,0,0,0,,J’en sais rien ! Mais ça va pas être bon !
Dialogue: 0,0:16:00.74,0:16:04.44,Main,Centaur2,0,0,0,,Peu importe, on doit juste courir jusqu’au labo,\Ncomme l’a dit le Maître.
Dialogue: 0,0:16:04.44,0:16:08.44,Main,Centaur,0,0,0,,Bon sang ! Pourquoi le traîneau a dû casser maintenant ?!
Dialogue: 0,0:16:08.44,0:16:10.92,Main,Centaur,0,0,0,,Maître !
Dialogue: 0,0:16:10.92,0:16:13.69,Main,Sanji,0,0,0,,Il agit bizarrement depuis qu’il a mangé ce bonbon.
Dialogue: 0,0:16:13.69,0:16:16.65,Main,Brook,0,0,0,,Le bonbon était-il vraiment si délicieux ?
Dialogue: 0,0:16:16.65,0:16:18.41,Main,Kinemon,0,0,0,,Nous devons nous dépêcher !
Dialogue: 0,0:16:18.41,0:16:20.95,Main,Kinemon,0,0,0,,Même ceux qui défendent cette île fuient pour sauver leur vie.
Dialogue: 0,0:16:20.95,0:16:23.08,Main,Kinemon,0,0,0,,Ça ne présage rien de bon pour la suite.
Dialogue: 0,0:16:23.08,0:16:24.74,Main,Zoro,0,0,0,,Je suis d’accord.
Dialogue: 0,0:16:32.58,0:16:34.94,Main,Caesar,0,0,0,,Bien joué, Smiley.
Dialogue: 0,0:16:35.33,0:16:36.98,Main,Caesar,0,0,0,,Adieu.
Dialogue: 0,0:17:01.56,0:17:04.39,Main,Caesar,0,0,0,,Salutations au nouveau-né…
Dialogue: 0,0:17:05.14,0:17:08.55,Main,Caesar,0,0,0,,L’arme de destruction massive, Shinokuni !
Dialogue: 0,0:17:09.50,0:17:12.60,Main,Caesar,0,0,0,,Change le paysage de cette île pour toujours !
Dialogue: 0,0:17:36.90,0:17:38.07,Main,Sheep,0,0,0,,Hé ! Attends-moi {\fscx250}-{\r}
Dialogue: 0,0:17:40.95,0:17:42.68,Main,Sheep,0,0,0,,Mes jambes !
Dialogue: 0,0:17:43.23,0:17:44.79,Main,Sheep,0,0,0,,Qu’est-ce qui se passe ?
Dialogue: 0,0:17:50.17,0:17:51.49,Main,Sheep,0,0,0,,Sauvez-moi…
Dialogue: 0,0:18:00.98,0:18:02.36,Main,Sheep2,0,0,0,,Que lui est-il arrivé ?!
Dialogue: 0,0:18:02.36,0:18:04.55,Main,Sheep,0,0,0,,On s’en fout ?! Fuis !
Dialogue: 0,0:18:11.22,0:18:12.41,Main,Sheep2,0,0,0,,Mon corps…
Dialogue: 0,0:18:13.69,0:18:15.03,Main,Sheep2,0,0,0,,ne… bouge… plus…
Dialogue: 0,0:18:18.68,0:18:20.77,Main,Sheep,0,0,0,,Fuyez ! Fuyez !
Dialogue: 0,0:18:20.77,0:18:22.98,Main,Sheepies,0,0,0,,Maître !
Dialogue: 0,0:18:28.04,0:18:30.53,Main,Caesar,0,0,0,,Oui ! C’est un succès !
Dialogue: 0,0:18:30.53,0:18:33.15,Main,Caesar,0,0,0,,Pas une seule âme ne peut s’échapper !
Dialogue: 0,0:18:33.15,0:18:34.94,Main,Caesar,0,0,0,,C’est parfait.
Dialogue: 0,0:18:35.67,0:18:40.02,Main,Caesar,0,0,0,,Le problème avec l’expérience précédente, c’est qu’il y avait des survivants.
Dialogue: 0,0:18:41.06,0:18:44.15,Main,Caesar,0,0,0,,Le poison a fonctionné mais ils pouvaient encore bouger un peu\Ndonc ils ont réussi à s’enfuir.
Dialogue: 0,0:18:44.15,0:18:45.66,Main,Caesar,0,0,0,,Mais !
Dialogue: 0,0:18:46.12,0:18:48.92,Main,Caesar,0,0,0,,Ça aurait bien mieux marché\Nsi j’avais pu les figer !
Dialogue: 0,0:18:48.92,0:18:52.33,Main,Caesar,0,0,0,,Ce gaz recouvre le corps comme de la cendre.
Dialogue: 0,0:18:53.64,0:18:57.36,Main,Caesar,0,0,0,,Il est absorbé par la peau et paralyse tout le corps.
Dialogue: 0,0:19:01.16,0:19:05.09,Main,Caesar,0,0,0,,Maintenant, mon arme de\Ndestruction massive parfaite, Shinokuni !
Dialogue: 0,0:19:05.68,0:19:10.46,Main,Caesar,0,0,0,,Montre-m’en plus ! Montre-moi le paysage infernal ultime !
Dialogue: 0,0:19:24.04,0:19:25.78,Main,Smoker,0,0,0,,Qu’est-ce que c’est ?
Dialogue: 0,0:19:26.31,0:19:27.87,Main,Luffy,0,0,0,,Les gens sont…
Dialogue: 0,0:19:31.08,0:19:33.06,Main,Sheep,0,0,0,,Sauvez-moi !
Dialogue: 0,0:19:35.12,0:19:36.90,Main,Luffy,0,0,0,,…en train de geler sur place !
Dialogue: 0,0:19:44.65,0:19:46.73,Main,Soldier,0,0,0,,Hé… qu’est-ce que c’est ?
Dialogue: 0,0:19:46.73,0:19:49.10,Main,Soldier,0,0,0,,Quelle est cette vidéo terrifiante ?
Dialogue: 0,0:19:49.10,0:19:52.95,Main,Soldier2,0,0,0,,Ceux qui sont morts ressemblaient aux subordonnés de Caesar.
Dialogue: 0,0:19:52.95,0:19:55.39,Main,Soldier,0,0,0,,C’est quoi cette fumée violette ?
Dialogue: 0,0:19:57.19,0:20:00.91,Main,Soldier2,0,0,0,,Au fait, quel pays montrent-ils ?
Dialogue: 0,0:20:00.91,0:20:03.72,Main,Soldier,0,0,0,,Eh bien, tu ferais mieux de ne pas regarder derrière toi.
Dialogue: 0,0:20:14.37,0:20:16.88,Main,Soldier,0,0,0,,Pas possible ! C’est arrivé sur {\i1}cette{\i0} île ?!
Dialogue: 0,0:20:17.33,0:20:19.25,Flashbacks,Sheep,0,0,0,,Maître !
Dialogue: 0,0:20:22.48,0:20:26.05,Main,Soldier,0,0,0,,Merde ! Si on ne court pas, on finira comme eux !
Dialogue: 0,0:20:26.05,0:20:30.33,Main,Soldier2,0,0,0,,Ça n’a pas d’importance !\NIl n’y a nulle part où courir sur cette île !
Dialogue: 0,0:20:30.33,0:20:32.99,Main,Soldier,0,0,0,,Oh, je vois ! C’est pour ça qu’ils ont scellé le laboratoire !
Dialogue: 0,0:20:32.99,0:20:34.77,Main,Soldier,0,0,0,,Pour empêcher le gaz d’entrer !
Dialogue: 0,0:20:37.75,0:20:40.20,Main,Soldier2,0,0,0,,Ouvrez ! Caesar ! Bon sang !
Dialogue: 0,0:20:40.20,0:20:42.46,Main,Soldier2,0,0,0,,Je vais pas crever dehors comme ça !
Dialogue: 0,0:20:42.46,0:20:44.81,Main,Soldier2,0,0,0,,Bon sang ! Bon sang ! Arrête de déconner !
Dialogue: 0,0:20:44.81,0:20:46.72,Main,Soldier2,0,0,0,,Ouvre !
Dialogue: 0,0:20:58.61,0:21:01.05,Main,All,0,0,0,,Fuyez !
Dialogue: 0,0:21:04.59,0:21:06.98,Main,Sanji,0,0,0,,Ça sent pas bon !
Dialogue: 0,0:21:09.29,0:21:11.06,Main,Zoro,0,0,0,,Vous, courez aussi vite que possible !
Dialogue: 0,0:21:11.06,0:21:12.74,Main,Zoro,0,0,0,,Si vous vous faites attraper, je vous laisse derrière !
Dialogue: 0,0:21:19.26,0:21:22.02,Main,Brook,0,0,0,,Zoro-san ! À ce rythme, on va tous…
Dialogue: 0,0:21:27.31,0:21:29.54,Main,Brooke,0,0,0,,Objet non identifié repéré à midi !
Dialogue: 0,0:21:29.54,0:21:31.43,Main,Sanji,0,0,0,,Qu’est-ce que c’est ?!
Dialogue: 0,0:21:31.43,0:21:32.78,Main,Zoro,0,0,0,,C’est un…
Dialogue: 0,0:21:36.77,0:21:38.15,Main,Zoro,0,0,0,,Dragon !
Dialogue: 0,0:21:38.15,0:21:39.47,Main,Brook+Sanji,0,0,0,,Un Dragon ?!
Dialogue: 0,0:21:39.47,0:21:40.79,Main,Kinemon,0,0,0,,Un Dragon ?!
Dialogue: 0,0:21:40.79,0:21:43.53,Main,Sanji,0,0,0,,Ne sois pas stupide ! Les dragons n’existent pas !
Dialogue: 0,0:21:43.53,0:21:45.17,Main,Zoro,0,0,0,,Ils en ont sur cette île !
Dialogue: 0,0:21:45.17,0:21:47.59,Main,Zoro,0,0,0,,Mais celui-ci est beaucoup plus petit que le premier.
Dialogue: 0,0:21:47.59,0:21:50.91,Main,Zoro,0,0,0,,Hé. Peut-être qu’on peut l’attraper et s’envoler !
Dialogue: 0,0:21:50.91,0:21:52.44,Main,Brook,0,0,0,,C’est une idée splendide !
Dialogue: 0,0:21:52.44,0:21:54.52,Main,Sanji,0,0,0,,C’est décidé ! On ne peut pas continuer comme ça éternellement !
Dialogue: 0,0:21:54.52,0:21:55.80,Main,Sanji,0,0,0,,On va l’attraper !
Dialogue: 0,0:21:55.80,0:21:59.02,Main,Sanji,0,0,0,,Reste où tu es, Dragon !
Dialogue: 0,0:22:04.73,0:22:07.70,Main,Luffy,0,0,0,,C’est mon équipage ! Ils sont poursuivis par la fumée !
Dialogue: 0,0:22:07.70,0:22:10.61,Main,Sanji,0,0,0,,Dragon !
Dialogue: 0,0:22:10.89,0:22:13.73,Main,Frankie,0,0,0,,Qu’est-ce qu’ils fabriquent dehors ?
Dialogue: 0,0:22:13.73,0:22:16.47,Main,Frankie,0,0,0,,Et c’est quoi cette façon de courir ?
Dialogue: 0,0:22:16.47,0:22:19.11,Main,Robin,0,0,0,,Il semble que le corps du samouraï soit de nouveau complet.
Dialogue: 0,0:22:19.11,0:22:21.36,Main,Luffy,0,0,0,,Hé, t’as raison.
Dialogue: 0,0:22:21.36,0:22:23.80,Main,Luffy,0,0,0,,Donc je suppose qu’il ne me donnera plus ses jambes.
Dialogue: 0,0:22:23.80,0:22:26.17,Main,Luffy,0,0,0,,Hé Robin ! Ce n’est pas le moment pour ça !
Dialogue: 0,0:22:27.38,0:22:30.18,Main,Luffy,0,0,0,,Hé, vous autres ! Cette fumée est dangereuse !
Dialogue: 0,0:22:30.18,0:22:32.05,Main,Luffy,0,0,0,,Fuyez…
Dialogue: 0,0:22:34.63,0:22:37.55,Main,Luffy,0,0,0,,C’est impossible. Si j’essaie de crier…
Dialogue: 0,0:22:37.55,0:22:40.39,Main,Luffy,0,0,0,,Foutu Kairoseki.
Dialogue: 0,0:22:41.28,0:22:44.57,Main,Caesar,0,0,0,,Oh, ce sont tes amis, Luffy au Chapeau de Paille ?
Dialogue: 0,0:22:46.86,0:22:50.33,Main,Caesar,0,0,0,,Comme on peut s’y attendre du grand\NPirates au Chapeau de Paille, ils sont plutôt coriaces.
Dialogue: 0,0:22:52.41,0:22:56.35,Main,Caesar,0,0,0,,Mais ils sont à quelques secondes de\Nse faire tuer par le gaz.
Dialogue: 0,0:22:59.50,0:23:01.90,Main,Caesar,0,0,0,,Et il continuera à se propager…
Dialogue: 0,0:23:01.90,0:23:05.23,Main,Caesar,0,0,0,,jusqu’à ce que rien ne puisse vivre sur cette île. Une terre de mort !
Dialogue: 0,0:23:07.52,0:23:14.06,Main,Caesar,0,0,0,,Personne en dehors de ce laboratoire ne pourra survivre.
Dialogue: 0,0:23:17.77,0:23:19.12,Main,Caesar,0,0,0,,Bien sûr…
Dialogue: 0,0:23:20.13,0:23:21.93,Main,Caesar,0,0,0,,cela t’inclura aussi, toi !
Dialogue: 0,0:23:24.03,0:23:25.29,Main,Luffy,0,0,0,,Quoi ?!
Dialogue: 0,0:23:39.24,0:23:42.79,Main,Caesar,0,0,0,,Maintenant, montrons au monde…
Dialogue: 0,0:23:42.79,0:23:46.39,Main,Caesar,0,0,0,,que contre mon arme de\Ndestruction massive, Shinokuni…
Dialogue: 0,0:23:46.76,0:23:48.96,Main,Caesar,0,0,0,,une prime de 400 millions,
Dialogue: 0,0:23:49.53,0:23:51.78,Main,Caesar,0,0,0,,un Vice-Amiral de la Marine,
Dialogue: 0,0:23:52.63,0:23:55.07,Main,Caesar,0,0,0,,et même l’un des Sept Grands Corsaires,
Dialogue: 0,0:23:56.23,0:24:01.89,Main,Caesar,0,0,0,,sont tous impuissants à se sauver de la mort !
Dialogue: 0,0:24:10.57,0:24:12.69,Thoughts,Chopper,0,0,0,,Que dois-je faire ? Que dois-je faire ?
Dialogue: 0,0:24:12.69,0:24:14.41,Thoughts,Chopper,0,0,0,,Il fait quelque chose avec Luffy et les autres !
Dialogue: 0,0:24:14.41,0:24:16.00,Thoughts,Chopper,0,0,0,,Que dois-je faire ?
Dialogue: 0,0:24:16.38,0:24:20.91,Thoughts,Chopper,0,0,0,,Je veux les sauver, mais avec ce corps blessé, je me ferais juste capturer.
Dialogue: 0,0:24:20.91,0:24:28.04,Thoughts,Chopper,0,0,0,,Si ça arrive, alors tous mes efforts pour enquêter sur la drogue et obtenir les sédatifs, seront gaspillés.
Dialogue: 0,0:24:28.04,0:24:31.60,Thoughts,Chopper,0,0,0,,Que dois-je faire ? Que dois-je faire ?
Dialogue: 0,0:24:39.29,0:24:41.24,Main,Chopper,0,0,0,,C’était dangereux. J’ai failli être repéré.
Dialogue: 0,0:24:41.24,0:24:42.75,Main,Chopper,0,0,0,,Hm ? Un papier ?
Dialogue: 0,0:24:45.36,0:24:47.10,Main,Chopper,0,0,0,,« Ne fais rien » ?
Dialogue: 0,0:24:47.84,0:24:48.88,Main,Chopper,0,0,0,,Qui a lancé ça ?
Dialogue: 0,0:24:52.33,0:24:54.00,Main,Soldier,0,0,0,,Serait-ce possible ?
Dialogue: 0,0:24:54.32,0:24:55.54,Main,Soldiers,0,0,0,,Smokey !
Dialogue: 0,0:24:55.54,0:24:56.54,Main,Soldiers,0,0,0,,Tashigi-chan !
Dialogue: 0,0:24:56.54,0:24:58.87,Main,Soldiers,0,0,0,,Dieu merci, tu vas bien !
Dialogue: 0,0:24:58.87,0:25:01.85,Main,Soldier,0,0,0,,Non... Ils sont toujours captifs !
Dialogue: 0,0:25:01.85,0:25:04.23,Main,Soldier2,0,0,0,,Bon sang ! On va tous se faire tuer, finalement !
Dialogue: 0,0:25:04.23,0:25:06.33,Main,Soldier,0,0,0,,Smokey ! Tashigi-chan !
Dialogue: 0,0:25:07.19,0:25:08.26,Main,Tashigi,0,0,0,,Nos hommes ?
Dialogue: 0,0:25:10.90,0:25:12.99,Main,Franky,0,0,0,,Mais plus important,
Dialogue: 0,0:25:15.31,0:25:18.85,Main,Franky,0,0,0,,C'est vraiment un laboratoire bien équipé.
Dialogue: 0,0:25:19.84,0:25:20.83,Main,Robin,0,0,0,,Tu as raison.
Dialogue: 0,0:25:22.16,0:25:25.92,Main,Robin,0,0,0,,Je parie qu'une installation comme celle-ci a\Nles moyens de transporter de grosses machines.
Dialogue: 0,0:25:25.92,0:25:28.15,Main,Tashigi,0,0,0,,Pourquoi discuter de\Ntelles choses en un moment pareil ?!
Dialogue: 0,0:25:28.15,0:25:32.42,Main,Luffy,0,0,0,,Hm, d'accord ! Quoi qu'il en soit, on est coincés.
Dialogue: 0,0:25:33.66,0:25:36.67,Main,Law,0,0,0,,Je n'avais pas prévu l'arrivée de Vergo, mais néanmoins...
Dialogue: 0,0:25:36.67,0:25:37.98,Main,Law,0,0,0,,Chapeau-de-paille.
Dialogue: 0,0:25:39.55,0:25:43.80,Main,Law,0,0,0,,On n'a pas le temps de traîner ici.
Dialogue: 0,0:25:44.09,0:25:46.19,Main,Law,0,0,0,,Le plan n'a pas changé.
Dialogue: 0,0:25:46.19,0:25:48.27,Main,Law,0,0,0,,Assure-toi de ne pas tout gâcher à partir de maintenant.
Dialogue: 0,0:25:50.52,0:25:52.32,Main,Law,0,0,0,,C'est l'heure de notre contre-attaque.
Comment: 0,0:00:00.00,0:00:00.00,Main,,0,0,0,,

